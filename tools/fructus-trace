#!/usr/bin/env python3
"""
Put the names back into the output of SOM++ on fructus.

    tools/fructus-trace build-fructus/SOM++ [output]

Fructus has no names of methods, selectors or classes, so it prints
numbers, which this translates with the ELF file, in the output of the
program (a file, or stdin):

  - A stack trace is a line of pcs, see VMFrame::PrintStackTrace(). After
    it comes the method or block and the source line of each frame, from
    the debug info the image writer puts in the ELF file.
  - sel@<n> is a selector or the name of a global, from the absolute
    symbols of _selectors.s, and class@<address> is a class, from its
    label.

The binutils for fructus are $FRUCTUS_ADDR2LINE and $FRUCTUS_NM,
fructus-elf-addr2line and fructus-elf-nm, or those in ~/fructus/build.
"""

import os
import re
import shutil
import subprocess
import sys


def binutil(name, built):
    variable = "FRUCTUS_" + name.upper()
    if variable in os.environ:
        return os.environ[variable]
    installed = shutil.which("fructus-elf-" + name)
    if installed:
        return installed
    return os.path.expanduser("~/fructus/build/binutils/binutils/" + built)


def demangle(mangled):
    """The inverse of Mangle() in FructusImageWriter.cpp."""
    result = ""
    i = 0
    while i < len(mangled):
        if mangled[i] != "_":
            result += mangled[i]
            i += 1
        elif mangled[i + 1] == "_":
            result += "_"
            i += 2
        else:
            result += chr(int(mangled[i + 1:i + 3], 16))
            i += 3
    return result


def names(elf):
    """The selectors by number and the classes by address."""
    result = subprocess.run([binutil("nm", "nm-new"), elf],
                            capture_output=True, text=True, check=True)
    selectors = {}
    classes = {}
    for line in result.stdout.splitlines():
        words = line.split()
        if len(words) != 3 or "." in words[2]:
            continue
        value, label = int(words[0], 16), words[2]
        if label.startswith("som_sym_"):
            selectors[value] = "#" + demangle(label[len("som_sym_"):])
        elif label.startswith("som_class_"):
            classes[value] = demangle(label[len("som_class_"):])
        elif label.startswith("som_meta_"):
            classes[value] = demangle(label[len("som_meta_"):]) + " class"
    return selectors, classes


def lookup(elf, pcs):
    """(function, file:line) of each pc, which is just after its send."""
    # the bytecode the frame is at is the one before the pc
    addresses = ["0x%x" % (pc - 1) for pc in pcs]
    # addr2line gives the first lookup in a compile unit the name of the ELF
    # symbol, and after that the one in the debug info, so look them all up
    # twice and take the second
    result = subprocess.run(
        [binutil("addr2line", "addr2line"), "-f", "-e", elf] + addresses * 2,
        capture_output=True, text=True, check=True)
    lines = result.stdout.splitlines()[2 * len(pcs):]
    return list(zip(lines[0::2], lines[1::2]))


def main():
    if len(sys.argv) not in (2, 3):
        sys.exit(__doc__.strip())
    elf = sys.argv[1]
    output = open(sys.argv[2]) if len(sys.argv) == 3 else sys.stdin
    selectors, classes = names(elf)

    def name(match):
        table = selectors if match.group(1) == "sel" else classes
        return table.get(int(match.group(2), 16), match.group(0))

    for line in output:
        if not line.startswith("pcs:"):
            sys.stdout.write(re.sub(r"\b(sel|class)@([0-9a-f]+)\b", name,
                                    line))
            continue
        print("Stack trace:")
        pcs = [int(word, 16) for word in line.split()[1:]]
        for pc, (function, where) in zip(pcs, lookup(elf, pcs)):
            if where.startswith("??"):
                where = "no source"
            print("  %04x %s at %s" % (pc, function, where))


if __name__ == "__main__":
    main()
